-- [[ FUNÇÕES AUXILIARES / DETECÇÃO ]] --

local function getBall()
    for _, item in pairs(workspace:GetDescendants()) do
        if (item.Name == "Ball" or item.Name == "Football" or item.Name:lower():find("ball")) and item:IsA("BasePart") then
            return item
        end
    end
    return nil
end

local function isBallNearMe(radius)
    local char = LocalPlayer.Character
    local ball = getBall()
    if char and char:FindFirstChild("HumanoidRootPart") and ball then
        return (char.HumanoidRootPart.Position - ball.Position).Magnitude <= (radius or 4)
    end
    return false
end

local function getClosestEnemy(distLimit)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil, math.huge end
    local myPos = char.HumanoidRootPart.Position
    local nearest, nearestDist = nil, distLimit or math.huge

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and (p.Team == nil or p.Team ~= LocalPlayer.Team) and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local d = (p.Character.HumanoidRootPart.Position - myPos).Magnitude
            if d < nearestDist then
                nearestDist = d
                nearest = p.Character
            end
        end
    end
    return nearest, nearestDist
end

local function getSmartGoalPosition()
    local bestGoalPos = nil
    local maxDist = 0
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return Vector3.new() end

    for _, obj in pairs(workspace:GetDescendants()) do
        if (obj.Name:lower():find("goal") or obj.Name:lower():find("net") or obj.Name:lower():find("trave")) and obj:IsA("BasePart") then
            local dist = (obj.Position - char.HumanoidRootPart.Position).Magnitude
            if dist > maxDist and dist < 260 then
                maxDist = dist
                bestGoalPos = obj.Position
            end
        end
    end

    if not bestGoalPos then
        return Camera.CFrame.Position + (Camera.CFrame.LookVector * 120)
    end

    -- Offset estratégico (Canto morto/Gaveta)
    local yOffset = 5.5
    if Settings.ShootMode == "Rasteiro" then
        yOffset = 1.0
    elseif Settings.ShootMode == "Gaveta (Superior)" then
        yOffset = 6.2
    end

    local xOffset = (math.random() > 0.5 and 7.5 or -7.5)
    return bestGoalPos + Vector3.new(xOffset, yOffset, 0)
end

