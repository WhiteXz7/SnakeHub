local Debounces = {Shoot = false, Dribble = false, Tackle = false, GK = false, Pass = false}

-- Loop Rápido (Heartbeat) para Combate
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local ball = getBall()

    -- 1. AUTO SHOOT
    if Settings.AutoShoot and not Debounces.Shoot and ball and isBallNearMe(4.5) then
        local targetGoal = getSmartGoalPosition()
        local dist = (targetGoal - char.HumanoidRootPart.Position).Magnitude
        
        if dist <= Settings.ShootDist then
            Debounces.Shoot = true
            task.wait(0.06) -- Delay humanizado de reação

            if Settings.CurveShoot and RemotesMap.CurveFactor then
                pcall(function()
                    local dir = (math.random() > 0.5 and 1 or -1) * Settings.CurveIntensity
                    RemotesMap.CurveFactor:FireServer(dir)
                end)
            end

            if RemotesMap.Shoot then
                pcall(function()
                    -- Precisão Pro Player 99%
                    local offsetFactor = (100 - Settings.Accuracy) / 100
                    local microVariation = Vector3.new(
                        (math.random() - 0.5) * offsetFactor * 3,
                        (math.random() - 0.5) * offsetFactor * 2,
                        0
                    )
                    RemotesMap.Shoot:FireServer(targetGoal + microVariation, Settings.Power)
                end)
            end

            task.wait(0.65)
            Debounces.Shoot = false
        end
    end

    -- 2. AUTO DRIBBLE (ANTI-TACKLE INTELIGENTE)
    if Settings.AutoDribble and not Debounces.Dribble and ball and isBallNearMe(4.2) then
        local enemy, enemyDist = getClosestEnemy(Settings.DribbleDist)
        if enemy and enemy:FindFirstChild("HumanoidRootPart") then
            local enemyVel = enemy.HumanoidRootPart.Velocity.Magnitude
            -- Se o adversário correu ou deu slide na sua direção
            if enemyDist <= Settings.DribbleDist and enemyVel > 7 then
                Debounces.Dribble = true
                task.wait(Settings.DribbleReaction)

                if RemotesMap.Action then
                    pcall(function()
                        RemotesMap.Action:FireServer("Dribble", math.random(1, 3))
                    end)
                end

                -- Corte de corpo lateral suave (estilo Top Global)
                local sideStep = char.HumanoidRootPart.CFrame.RightVector * (math.random() > 0.5 and 10 or -10)
                char.HumanoidRootPart.Velocity = char.HumanoidRootPart.Velocity + sideStep

                task.wait(0.85)
                Debounces.Dribble = false
            end
        end
    end

    -- 3. AUTO TACKLE
    if Settings.AutoTackle and not Debounces.Tackle and ball and not isBallNearMe(2.8) then
        local enemy, enemyDist = getClosestEnemy(Settings.TackleDist)
        if enemy and enemyDist <= Settings.TackleDist then
            local ballToEnemy = (ball.Position - enemy.HumanoidRootPart.Position).Magnitude
            if ballToEnemy <= 4.0 then
                Debounces.Tackle = true
                task.wait(0.05)
                
                if RemotesMap.Tackle then
                    pcall(function()
                        RemotesMap.Tackle:FireServer()
                    end)
                end

                task.wait(0.55)
                Debounces.Tackle = false
            end
        end
    end

    -- 4. AUTO GK
    if Settings.AutoGK and not Debounces.GK and ball then
        local ballDist = (ball.Position - char.HumanoidRootPart.Position).Magnitude
        if ballDist <= Settings.GKRange and ball.Velocity.Magnitude > 22 then
            local toPlayerDir = (char.HumanoidRootPart.Position - ball.Position).Unit
            if ball.Velocity.Unit:Dot(toPlayerDir) > 0.45 then
                Debounces.GK = true
                
                if RemotesMap.GKHitbox then
                    pcall(function()
                        RemotesMap.GKHitbox:FireServer(ball.Position)
                    end)
                end

                if RemotesMap.Action then
                    pcall(function()
                        local side = (ball.Position - char.HumanoidRootPart.Position).X > 0 and "Right" or "Left"
                        RemotesMap.Action:FireServer("GKDive", side)
                    end)
                end

                task.wait(1.1)
                Debounces.GK = false
            end
        end
    end
end)

-- Loop Secundário (Stamina, Drops, Anti-AFK)
task.spawn(function()
    while true do
        task.wait(0.2)
        -- Infinite Stamina
        if Settings.InfiniteStamina and RemotesMap.SpeedRemote then
            pcall(function()
                RemotesMap.SpeedRemote:FireServer(true, 100)
            end)
        end

        -- Coletor de Moedas pelo mapa
        if Settings.AutoCollectCoins and RemotesMap.Collect then
            pcall(function()
                for _, obj in pairs(workspace:GetChildren()) do
                    if obj.Name:find("Coin") or obj.Name:find("Token") then
                        RemotesMap.Collect:FireServer(obj)
                    end
                end
            end)
        end

        -- Skip Cuts/Celebrations
        if Settings.SkipCelebration and RemotesMap.Cutscene then
            pcall(function()
                RemotesMap.Cutscene:FireServer("Skip")
            end)
        end

        -- Anti-AFK Remote
        if Settings.AntiAFK and RemotesMap.AFK then
            pcall(function()
                RemotesMap.AFK:FireServer(false)
            end)
        end
    end
end)

