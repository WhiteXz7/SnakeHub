-- [[ FUNÇÕES DE FÍSICA E PARTIDA ]] --

local function getBall()
    for _, part in pairs(workspace:GetDescendants()) do
        if (part.Name == "Ball" or part.Name == "Football" or part.Name:lower():find("ball")) and part:IsA("BasePart") then
            return part
        end
    end
    return nil
end

local function isBallNear(radius)
    local char = LocalPlayer.Character
    local ball = getBall()
    if char and char:FindFirstChild("HumanoidRootPart") and ball then
        return (char.HumanoidRootPart.Position - ball.Position).Magnitude <= radius
    end
    return false
end

local function getClosestEnemy(maxDist)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil, math.huge end
    local myPos = char.HumanoidRootPart.Position
    local closest, cDist = nil, maxDist or math.huge

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and (plr.Team == nil or plr.Team ~= LocalPlayer.Team) and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (plr.Character.HumanoidRootPart.Position - myPos).Magnitude
            if dist < cDist then
                cDist = dist
                closest = plr.Character
            end
        end
    end
    return closest, cDist
end

local function getSmartGoal()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        return Camera.CFrame.Position + (Camera.CFrame.LookVector * 100)
    end

    local bestGoal = nil
    local maxDist = 0

    for _, obj in pairs(workspace:GetDescendants()) do
        if (obj.Name:lower():find("goal") or obj.Name:lower():find("net") or obj.Name:lower():find("trave")) and obj:IsA("BasePart") then
            local dist = (obj.Position - char.HumanoidRootPart.Position).Magnitude
            if dist > maxDist and dist < 260 then
                maxDist = dist
                bestGoal = obj.Position
            end
        end
    end

    if not bestGoal then
        return char.HumanoidRootPart.Position + (char.HumanoidRootPart.CFrame.LookVector * 80)
    end

    local yOffset = 5.8
    if Config.TargetArea == "Rasteiro" then
        yOffset = 1.2
    elseif Config.TargetArea == "Meio" then
        yOffset = 3.5
    end

    local xOffset = (math.random() > 0.5 and 7 or -7)
    return bestGoal + Vector3.new(xOffset, yOffset, 0)
end

