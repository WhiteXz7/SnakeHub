-- MOTOR PRINCIPAL DO SCRIPT (LOOPS DE COMBATE)
-- ==========================================================

local Debounce = {Shoot = false, Dribble = false, Tackle = false, GK = false}

RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local ball = getBall()

    -- 1. AUTO SHOOT PRO
    if Config.AutoShoot and not Debounce.Shoot and ball and isBallNear(4.5) then
        local goalTarget = getSmartGoal()
        local distToGoal = (goalTarget - char.HumanoidRootPart.Position).Magnitude

        if distToGoal <= Config.ShootDist then
            Debounce.Shoot = true
            task.wait(0.06) -- Micro delay de reação humana (Legit)

            if Config.CurveShoot and Remotes.CurveFactor then
                pcall(function()
                    local dir = (math.random() > 0.5 and 1 or -1) * Config.CurveIntensity
                    Remotes.CurveFactor:FireServer(dir)
                end)
            end

            if Remotes.Shoot then
                pcall(function()
                    local acc = (100 - Config.Accuracy) / 100
                    local naturalOffset = Vector3.new((math.random() - 0.5) * acc * 3, (math.random() - 0.5) * acc * 2, 0)
                    Remotes.Shoot:FireServer(goalTarget + naturalOffset, Config.Power)
                end)
            end

            task.wait(0.7)
            Debounce.Shoot = false
        end
    end

    -- 2. AUTO DRIBBLE PRO
    if Config.AutoDribble and not Debounce.Dribble and ball and isBallNear(4.2) then
        local enemy, eDist = getClosestEnemy(Config.DribbleDist)
        if enemy and enemy:FindFirstChild("HumanoidRootPart") then
            -- Se o adversário correu ou deu tackle rápido
            if eDist <= Config.DribbleDist and enemy.HumanoidRootPart.Velocity.Magnitude > 7 then
                Debounce.Dribble = true
                task.wait(0.05)

                if Remotes.Action then
                    pcall(function()
                        Remotes.Action:FireServer("Dribble", math.random(1, 3))
                    end)
                end

                -- Corte de corpo lateral suave de Pro Player
                local sideDir = char.HumanoidRootPart.CFrame.RightVector * (math.random() > 0.5 and 11 or -11)
                char.HumanoidRootPart.Velocity = char.HumanoidRootPart.Velocity + sideDir

                task.wait(0.8)
                Debounce.Dribble = false
            end
        end
    end

    -- 3. AUTO TACKLE
    if Config.AutoTackle and not Debounce.Tackle and ball and not isBallNear(2.5) then
        local enemy, eDist = getClosestEnemy(Config.TackleDist)
        if enemy and eDist <= Config.TackleDist then
            local enemyToBall = (ball.Position - enemy.HumanoidRootPart.Position).Magnitude
            if enemyToBall <= 4.2 then
                Debounce.Tackle = true
                task.wait(0.04)

                if Remotes.Tackle then
                    pcall(function()
                        Remotes.Tackle:FireServer()
                    end)
                end

                task.wait(0.5)
                Debounce.Tackle = false
            end
        end
    end

    -- 4. AUTO GK
    if Config.AutoGK and not Debounce.GK and ball then
        local ballDist = (ball.Position - char.HumanoidRootPart.Position).Magnitude
        if ballDist <= Config.GKRange and ball.Velocity.Magnitude > 20 then
            local toCharDir = (char.HumanoidRootPart.Position - ball.Position).Unit
            if ball.Velocity.Unit:Dot(toCharDir) > 0.4 then
                Debounce.GK = true

                if Remotes.GKHitbox then
                    pcall(function()
                        Remotes.GKHitbox:FireServer(ball.Position)
                    end)
                end

                if Remotes.Action then
                    pcall(function()
                        local side = (ball.Position - char.HumanoidRootPart.Position).X > 0 and "Right" or "Left"
                        Remotes.Action:FireServer("GKDive", side)
                    end)
                end

                task.wait(1.0)
                Debounce.GK = false
            end
        end
    end

    -- 5. AUTO FACEOFF
    if Config.AutoFaceoff and Remotes.Faceoff and ball and isBallNear(10) then
        pcall(function()
            Remotes.Faceoff:FireServer()
        end)
    end
end)

